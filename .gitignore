node_modules/

# Raw Tibia client asset containers (binary, ~270MB) — used by
# extractor/scripts/extract_sprites.py / extractor/_legacy/read_aec.py.
extractor/*.aec

# Extracted sprite library + per-map sprite copies (binary, large).
extractor/**/sprites/

# Baked outfit sprite atlases (binary, generated by bake_outfit_atlas.py).
extractor/atlases/

# Generated pipeline output — regenerate with extractor/scripts/build_map.js.
extractor/raw-maps/**
extractor/ready-maps/**

__pycache__/
*.pyc
