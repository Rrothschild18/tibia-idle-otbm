node_modules/

# Containers .aec do Assets Editor — insumo APOSENTADO (ver ticket 08). O
# estágio 0 lê a pasta assets/ do cliente Tibia direto. A regra fica para que
# um checkout antigo com os arquivos em disco não os reintroduza.
extractor/*.aec

# Extracted sprite library + per-map sprite copies (binary, large).
extractor/**/sprites/

# Baked outfit sprite atlases (binary, generated by bake_outfit_atlas.py).
extractor/atlases/

# Generated pipeline output — regenerate with extractor/scripts/build_map.js.
extractor/raw-maps/**
extractor/ready-maps/**
# Same, for the map.json v6 tree written alongside it (ADR 0006). Separate
# roots so the directory the game consumes today stays untouched until it
# migrates — see .scratch/modelo-render-rme/spec.md.
extractor/ready-maps-v6/**

# Full-city map output (extractor/full-maps/<name>/): map.json + metadata.json
# ARE versioned (inspection artifact for the travel-graph pipeline — see
# .scratch/travel-graph-and-locations), but the baked sheet PNGs and the
# review-only db-fragment.json (build_travel_fragment.py, no --write-db) are
# not (binary/regenerable and a local-review scratch file, respectively —
# same reasoning as ready-maps/** above).
# travel-graph-rejections.txt IS versioned, unlike its sibling db-fragment.json:
# it's the hand-consumed list of what has no way into the graph, and its
# deterministic ordering only buys a clean diff if git is holding the baseline.
extractor/full-maps/*/sheets/
extractor/full-maps/*/db-fragment.json

# O mapa de cidade inteira não produz mais map.json/metadata.json: o
# travel-graph nunca leu um mapa, só as flags por appearance, que agora vivem
# versionadas em extractor/appearance-flags/<CIDADE>.json. Ignorados aqui para
# que um checkout antigo com os arquivos ainda em disco não os reintroduza.
extractor/full-maps/*/map.json
extractor/full-maps/*/metadata.json

# Backups the map editor writes next to the .otbm it saves. The .otbm itself
# is versioned, so git already is the backup.
*.otbm.bak

__pycache__/
*.pyc

# Env do uv, recriada por `uv sync` a partir de pyproject.toml + uv.lock.
# (O uv já escreve um .venv/.gitignore, mas deixar explícito evita surpresa
# se alguém criar a env com outra ferramenta.)
.venv/
